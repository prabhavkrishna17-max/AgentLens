# AgentLens Frontend Environment Variables
# ----------------------------------------

# The base URL of the AgentLens backend API.
# Leave empty or undefined for local development to use the Vite proxy.
# For production (e.g. Cloudflare Pages), set this to the absolute URL of the deployed backend.
# Example: https://api.your-agentlens-domain.com
VITE_API_BASE_URL=
