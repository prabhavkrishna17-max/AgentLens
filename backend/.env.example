# AgentLens Backend Environment Variables
# ---------------------------------------

# The absolute URL of the AgentLens frontend. Used to configure CORS origins.
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173

# The connection string for the database.
DATABASE_URL=sqlite:///agentlens.db

# Global default environment name for runs.
AGENTLENS_ENVIRONMENT=development

# The backend API URL for the AgentLens SDK
AGENTLENS_API_URL=http://localhost:8000

# Groq LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
