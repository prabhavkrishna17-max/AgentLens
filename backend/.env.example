# AgentLens Backend Environment Variables
# ---------------------------------------

# The absolute URL of the AgentLens frontend. Used to configure CORS origins.
# For local development, it defaults to http://localhost:5173.
# For production, set this to your deployed frontend domain.
# Example: https://app.your-agentlens-domain.com
FRONTEND_ORIGIN=http://localhost:5173

# The connection string for the database.
# For local development, it defaults to a local SQLite file (sqlite:///agentlens.db)
# For production container environments, provide an appropriate database URL.
# Example: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///agentlens.db

# (Optional) Global default environment name for runs.
AGENTLENS_ENVIRONMENT=production
